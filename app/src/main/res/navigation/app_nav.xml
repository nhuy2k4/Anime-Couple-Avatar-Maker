<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/app_nav"
    app:startDestination="@id/splashFragment">

    <include app:graph="@navigation/nav_graph_language_onboard" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.app.base.ui.splash.SplashFragment"
        tools:layout="@layout/fragment_splash" />

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.app.base.ui.home.HomeFragment"
        tools:layout="@layout/fragment_home" >
        <action
            android:id="@+id/action_homeFragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/categoryFragment"
        android:name="com.app.base.ui.category.CategoryFragment"
        tools:layout="@layout/fragment_category" >
        <action
            android:id="@+id/actionCategoryFragmentToPhotographFragment"
            app:destination="@id/photographFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"/>
        <argument
            android:name="outfitId"
            app:argType="long"
            android:defaultValue="-1L"/>
        <argument
            android:name="fromHome"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="backgroundId"
            app:argType="integer"
            android:defaultValue="-1" />
        <argument
            android:name="mode"
            app:argType="string"
            android:defaultValue="A" />
    </fragment>
    <fragment
        android:id="@+id/arenaSelectFragment"
        android:name="com.app.base.ui.battle.ArenaSelectFragment"
        tools:layout="@layout/fragment_arena_select" >
        <action
            android:id="@+id/action_arenaSelectFragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />
    </fragment>
    <fragment
        android:id="@+id/languageAppFragment"
        android:name="com.app.base.ui.language.LanguageAppFragment"
        tools:layout="@layout/fragment_language_app" />
    <fragment
        android:id="@+id/checkPointFragment"
        android:name="com.app.base.ui.checkpoint.CheckPointFragment"
        tools:layout="@layout/fragment_check_point" />
    <fragment
        android:id="@+id/battleFragment"
        android:name="com.app.base.ui.battle.BattleFragment"
        tools:layout="@layout/fragment_battle" />
    <fragment
        android:id="@+id/waitingFragment"
        android:name="com.app.base.ui.battle.WaitingFragment"
        tools:layout="@layout/fragment_waiting" />
    <fragment
        android:id="@+id/photographFragment"
        android:name="com.app.base.ui.photograph.PhotographFragment"
        tools:layout="@layout/fragment_photograph" >
        <action
            android:id="@+id/action_photographFragment_to_categoryFragment"
            app:destination="@id/categoryFragment" />
        <argument
            android:name="outfitId"
            app:argType="long" />
    </fragment>
    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.app.base.ui.gallery.GalleryFragment"
        tools:layout="@layout/fragment_gallery" >
        <action
            android:id="@+id/action_galleryFragment_to_photographFragment"
            app:destination="@id/photographFragment" />
    </fragment>
</navigation>
