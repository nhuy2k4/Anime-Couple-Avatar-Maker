<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F8BBD0"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/tvTitle"
        android:text="Profile"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <ImageView
        android:id="@+id/btnClose"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="24dp"
        android:layout_height="24dp" />
    <!-- Profile Picture + Player -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:layout_width="200dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvPlayer"
            android:text="Player"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_art_border"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"
            android:layout_width="150dp"
            android:layout_height="35dp" />

        <ImageView
            android:id="@+id/imgDropdown"
            android:src="@drawable/editor"
            android:tint="@android:color/white"
            app:layout_constraintEnd_toEndOf="@id/tvPlayer"
            app:layout_constraintTop_toTopOf="@id/tvPlayer"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="@id/tvPlayer"
            android:layout_marginStart="8dp"
            android:layout_width="20dp"
            android:layout_height="20dp" />
        <ImageView
            android:id="@+id/imgAvatar"
            android:src="@drawable/profile"
            android:scaleType="centerCrop"
            android:layout_width="80dp"
            android:layout_height="80dp" />
</androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Stats Section -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="330dp"
    android:layout_height="150dp"
    app:layout_constraintTop_toBottomOf="@id/profile">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_marginTop="32dp"
        android:weightSum="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Match -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_art_border"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Match"
                android:textColor="#8E24AA"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="2"
                android:textSize="18sp"
                android:textColor="#8E24AA"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Win Rate -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_art_border"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Win Rate"
                android:textColor="#8E24AA"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="100%"
                android:textSize="18sp"
                android:textColor="#8E24AA"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stats Section 2 -->
    <LinearLayout
        app:layout_constraintBottom_toBottomOf="parent"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:weightSum="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Item -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_art_border"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Item"
                android:textColor="#8E24AA"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="866"
                android:textSize="18sp"
                android:textColor="#8E24AA"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Ranking -->
        <LinearLayout
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_art_border"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

            <TextView
                android:text="Ranking"
                android:textColor="#8E24AA"
                android:textStyle="bold"
                android:layout_marginTop="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="#1000"
                android:textSize="18sp"
                android:textColor="#8E24AA"
                android:layout_marginBottom="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
