<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground">

    <TextView android:id="@+id/tv_rank" android:layout_width="32dp" android:layout_height="wrap_content"/>
    <ImageView android:id="@+id/iv_medal" android:layout_width="24dp" android:layout_height="24dp"/>
    <TextView android:id="@+id/tv_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
    <TextView android:id="@+id/tv_score" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
