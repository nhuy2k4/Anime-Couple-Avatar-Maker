<?xml version="1.0" encoding="utf-8"?>
<!-- language: xml -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:padding="10dp"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_task_item">

    <!-- Left: icon + badge -->
    <FrameLayout
        android:id="@+id/leftIconWrap"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/imgReward"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_gift"
            android:contentDescription="@string/desc_reward_icon" />

        <TextView
            android:id="@+id/tvRewardAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:background="@drawable/bg_reward_badge"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/default_reward_amount"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginStart="-6dp"
            android:layout_marginBottom="-6dp" />
    </FrameLayout>

    <!-- Right: action button -->
    <Button
        android:id="@+id/btnGoNow"
        android:layout_width="96dp"
        android:layout_height="40dp"
        android:text="@string/go_now"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_btn_go_now"
        android:padding="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBaseline_toBaselineOf="@id/leftIconWrap" />

    <!-- Center: title + progress -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/centerContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintStart_toEndOf="@id/leftIconWrap"
        app:layout_constraintEnd_toStartOf="@id/btnGoNow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tvTaskDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/sample_task_desc"
            android:textColor="#5A2A6E"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <ProgressBar
            android:id="@+id/progressTask"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:progressDrawable="@drawable/progress_task"
            android:progress="0"
            android:max="1"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTaskDesc"/>

        <TextView
            android:id="@+id/tvTaskProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/default_task_progress"
            android:textSize="12sp"
            android:textColor="#5A2A6E"
            android:layout_marginTop="0dp"
            app:layout_constraintEnd_toEndOf="@id/progressTask"
            app:layout_constraintTop_toTopOf="@id/progressTask"
            app:layout_constraintBottom_toBottomOf="@id/progressTask"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
