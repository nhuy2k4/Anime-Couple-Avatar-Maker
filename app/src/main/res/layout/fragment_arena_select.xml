<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="@dimen/_150dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/topPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <!-- Top Avatar -->
        <ImageView
            android:id="@+id/avatar_top"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/profile"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Top Name -->
        <TextView
            android:id="@+id/name_top"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="Player"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/avatar_top"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:id="@+id/vs_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="VS"
        android:textSize="64sp"
        android:textStyle="bold"
        android:textColor="#FFF176"
        android:shadowColor="#FF4081"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="8"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/botPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/vs_text">
        <!-- Top Avatar -->
        <ImageView
            android:id="@+id/imgSelectedBotAvatar"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/avatar_1"
            app:layout_constraintEnd_toEndOf="parent"/>
        <!-- Top Name -->
        <TextView
            android:id="@+id/tvSelectedBotName"
            android:layout_width="160dp"
            android:layout_height="40dp"
            android:text="NPC"
            android:textSize="22sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/imgSelectedBotAvatar"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:id="@+id/rootArena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        app:layout_constraintTop_toBottomOf="@id/vs_text"
        android:layout_marginBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <!-- Row 1: 3 items -->
        <LinearLayout
            android:id="@+id/row1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
        </LinearLayout>

        <!-- Row 2: 4 items -->
        <LinearLayout
            android:id="@+id/row2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">
        </LinearLayout>

        <!-- Row 3: 3 items -->
        <LinearLayout
            android:id="@+id/row3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

