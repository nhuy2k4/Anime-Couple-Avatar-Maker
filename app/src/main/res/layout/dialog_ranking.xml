<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_task"
    android:padding="0dp">

    <!-- Header Ranking -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/bg_task_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp">
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_gift"/>
        <TextView
            android:id="@+id/tvRankingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ranking"
            android:textColor="#A040C9"
            android:textStyle="bold"
            android:textSize="22sp"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"/>
    </LinearLayout>

    <!-- Nút đóng -->
    <ImageView
        android:id="@+id/btnClose"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_close"
        android:background="@drawable/bg_btn_close"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top 3 Ranking -->
    <LinearLayout
        android:id="@+id/layoutTop3"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp">
        <!-- Sẽ inflate 3 view con cho top 3 -->
    </LinearLayout>

    <!-- Thanh mốc điểm -->
    <LinearLayout
        android:id="@+id/layoutMilestone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/layoutTop3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <!-- Sẽ inflate các icon quà tặng và mốc điểm -->
    </LinearLayout>

    <!-- Danh sách ranking -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcvRanking"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/layoutMilestone"
        app:layout_constraintBottom_toTopOf="@id/layoutBottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"/>

    <!-- Bottom: Raise your ranking + PK Battle -->
    <LinearLayout
        android:id="@+id/layoutBottom"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">
        <TextView
            android:id="@+id/tvRaise"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raise your ranking?"
            android:textColor="#A040C9"
            android:textStyle="bold"
            android:textSize="18sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="4dp"/>
        <Button
            android:id="@+id/btnPkBattle"
            android:layout_width="220dp"
            android:layout_height="48dp"
            android:text="PK Battle"
            android:textColor="#A040C9"
            android:textStyle="bold"
            android:textSize="20sp"
            android:background="@drawable/bg_btn_go_now"
            android:layout_marginTop="2dp"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

