<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Small rounded badge background used for reward amount (e.g. x50) -->
    <size android:height="20dp" />

    <solid android:color="#D36CE6" />

    <corners android:radius="10dp" />

    <padding
        android:left="6dp"
        android:top="2dp"
        android:right="6dp"
        android:bottom="2dp" />

    <stroke android:width="1dp" android:color="#FFFFFF" android:dashWidth="0dp" />
</shape>

